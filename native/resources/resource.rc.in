#include <windows.h>

101 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.ico"
1 24 "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.manifest"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION @APP_VERSION_COMMA@,0
    PRODUCTVERSION @APP_VERSION_COMMA@,0
    FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS VS_FF_DEBUG
#else
    FILEFLAGS 0x0
#endif
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "yawaside"
            VALUE "FileDescription", "YawaFPS HUD - lightweight in-game monitoring overlay"
            VALUE "FileVersion", "@APP_VERSION@"
            VALUE "InternalName", "YawaFPSHUD"
            VALUE "ProductName", "YawaFPS HUD"
            VALUE "ProductVersion", "@APP_VERSION@"
            VALUE "OriginalFilename", "YawaFPSHUD.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
